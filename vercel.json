{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@now/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/stp_job_checkout_automatico_depois_90",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/stp_job_controle_diario_nao_preenchido",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/stp_job_gera_automatico_agendamento",
      "schedule": "* * * * *"
    }
  ]
}