{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@now/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "crons": [{
    "path": "/api/cron",
    "schedule": "* * * * *"
  }],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  }
}